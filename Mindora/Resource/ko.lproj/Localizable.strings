// MARK: - FAQ
"subscription.renewal_management" = "구독 관리";
"faq.title" = "Mindora 자주 묻는 질문";
"faq.subtitle" = "Mindora는 다감각 시너지와 AI를 통해 수면의 질을 개선하도록 설계된 스마트 수면 보조 기기입니다. 의료 기기가 아닙니다. 다음은 자주 묻는 질문에 대한 답변입니다.";
"faq.footer.prefix" = "다른 질문이 있으시면 Mindora 웹사이트의 ";
"faq.footer.link" = "고객 지원 센터";
"faq.footer.suffix" = "를 방문하세요.";

"faq.q1" = "구독 플랜은 어떻게 선택하나요?";
"faq.a1" = "월간 구독: 월 $2.99.\n\n연간 구독: 연 $29.99로 약 2개월분의 비용을 절약할 수 있습니다.\n\n실제 가격은 국가 또는 지역과 적용되는 세금에 따라 약간 다를 수 있으니 구독 페이지에서 최종 금액을 확인해 주세요.\n\nMindora 온라인 스토어에서 기기를 구매하면 주문에 선결제 연간 멤버십 플랜을 추가할 수도 있습니다.\n\n2026년 12월 25일 이전에 기기를 구매한 신규 회원은 Mindora 멤버십 첫 1년을 무료로 받습니다. 이 무료 기간이 끝난 후에는 멤버십을 별도로 구매해야 합니다.\n\nMindora 멤버십은 실제 Mindora 기기가 아니라 Mindora 계정에 연결됩니다. 기존 Mindora 계정으로 추가 기기를 구매해도 무료 멤버십 월이 추가로 제공되지 않습니다.";

"faq.q2" = "멤버십은 어떻게 활성화하나요?";
"faq.a2" = "멤버십 기간이 포함된 하드웨어 번들을 구매한 경우, 처음으로 기기를 성공적으로 연결하고 앱에 로그인하면 무료 멤버십이 자동으로 활성화됩니다.\n\n멤버십을 별도로 구매한 경우, Mindora 앱에서 “계정 업그레이드” 또는 “구독”을 탭하고 플랜을 선택한 후 결제를 완료하면 즉시 활성화됩니다.";

"faq.q3" = "어떤 휴대폰 운영체제가 Mindora 앱과 호환되나요?";
"faq.a3" = "Mindora 앱은 iOS 15 이상을 실행하는 iPhone과 블루투스 5.0을 지원하는 Android 11 이상의 안드로이드 휴대폰을 지원합니다.";

"faq.q4" = "휴대폰 블루투스를 항상 켜 두어야 하나요?";
"faq.a4" = "네. 기기와 앱의 동기화를 유지하고 원격 제어를 사용하려면 블루투스를 켜 두어야 합니다. 다만 기기 자체는 사전 설정된 수면 프로그램을 독립적으로 실행할 수 있습니다.";

"faq.q5" = "기기를 어떻게 연결/페어링하나요?";
"faq.a5" = "휴대폰의 블루투스를 켜고 Mindora 앱을 실행한 후 홈 화면에서 “기기 추가”를 탭하고 화면의 안내에 따르세요. 자세한 단계별 안내는 [관련 도움말 문서 링크]를 참고하세요.";

"faq.q6" = "Mindora가 다른 건강 앱(예: Apple 건강, Google Fit)과 데이터를 동기화할 수 있나요?";
"faq.a6" = "네. Mindora 앱의 “설정” > “앱 및 서비스”에서 수면 데이터를 Apple 건강이나 Google Fit 같은 플랫폼에 동기화하도록 승인할 수 있습니다.";

"faq.q7" = "모든 기능을 사용하려면 유료 구독이 필요한가요?";
"faq.a7" = "Mindora의 핵심 수면 보조 기능(기본 사운드, 조명 장면, 아로마 디퓨전 등)과 AI 수면 모니터링은 하드웨어를 구매하면 사용할 수 있습니다. 프리미엄 멤버십(해당하는 경우)은 더 풍부한 사운드 라이브러리, 개인 맞춤형 수면 분석 리포트, 고급 수면 강좌, 독점 ASMR 콘텐츠, 더욱 세밀하게 개인화된 AI 알고리즘 등을 잠금 해제합니다.";

"faq.q8" = "구독은 어떻게 관리하거나 취소하나요?";
"faq.a8" = "Mindora 앱의 “계정 설정”에서 언제든지 구독을 관리할 수 있습니다. iOS App Store 또는 Google Play 스토어를 통한 구매의 경우 해당 스토어의 구독 페이지에서도 관리해야 합니다.";

"faq.q9" = "내 수면 데이터는 안전한가요? Mindora는 내 개인정보를 어떻게 보호하나요?";
"faq.a9" = "데이터 보안은 무엇보다 중요합니다. 당사는 업계 표준 암호화를 사용하여 전송 중 및 저장 중인 데이터를 보호합니다. 당사가 개인정보를 수집, 사용, 보호하는 방법은 전체 Mindora 개인정보 처리방침에서 확인할 수 있습니다.";

"faq.q10" = "계정과 데이터를 삭제할 수 있나요?";
"faq.a10" = "네. Mindora 앱의 “계정 설정”에서 “계정 삭제” 옵션을 찾거나 고객 지원에 요청할 수 있습니다. 삭제 후 귀하의 개인 데이터는 당사의 활성 서버에서 제거됩니다.";

"faq.q11" = "Mindora 멤버십은 어디에서 관리하거나 취소할 수 있나요?";
"faq.a11" = "앱 내 관리: Mindora 앱의 “계정 설정” > “내 구독”에서 다음 갱신일 확인, 결제 수단 변경, 자동 갱신 취소를 언제든지 할 수 있습니다.\n\n앱 스토어 관리: iOS 또는 Android 앱 스토어를 통해 구독한 경우 해당 스토어의 구독 관리 페이지에서도 취소해야 합니다. 취소는 현재 결제 주기가 끝날 때 적용됩니다.";


