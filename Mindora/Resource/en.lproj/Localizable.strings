// MARK: - FAQ
"subscription.renewal_management" = "Subscription Management";
"faq.title" = "Mindora FAQs";
"faq.subtitle" = "Mindora is an AI-powered sleep companion that brings together sound, light, aroma, and guided relaxation to create a more personalized sleep experience. Mindora is not a medical device.\nFind answers to some of the most common questions below.";
"faq.footer.prefix" = "Still have questions? Visit ";
"faq.footer.link" = "Mindora Support";
"faq.footer.suffix" = " on our website.";

"faq.q1" = "Which membership plan is right for me?";
"faq.a1" = "Monthly subscription: $2.99/month.\n\nAnnual subscription: $29.99/year, saving you roughly 2 months of fees.\n\nActual prices may vary slightly depending on your country or region and applicable taxes—please check the final amount on the subscription page.\n\nIf you buy your device from the Mindora online store, you can also add a prepaid annual membership plan to your order.\n\nNew members who purchase a device before December 25, 2026 receive a complimentary first year of Mindora membership. After this free period, membership must be purchased separately.\n\nMindora membership is tied to your Mindora account, not your physical Mindora device. If you buy additional devices with an existing Mindora account, you will not receive another free membership month.";

"faq.q2" = "How do I activate my membership?";
"faq.a2" = "If you purchased a hardware bundle that includes a membership period, the complimentary membership is activated automatically the first time you successfully connect your device and sign in to the app.\n\nIf you purchased a membership separately, simply tap “Upgrade Account” or “Subscribe” in the Mindora app, choose a plan, and complete payment to activate it immediately.";

"faq.q3" = "Which devices are compatible with the Mindora App?";
"faq.a3" = "The Mindora app supports iPhones running iOS 15 or later, and Android phones running Android 11 or later with Bluetooth 5.0 support.";

"faq.q4" = "Do I need to keep Bluetooth turned on?";
"faq.a4" = "Yes. To keep your device and the app in sync and to enable remote control, Bluetooth needs to be on. However, the device itself can independently run its preset sleep programs.";

"faq.q5" = "How do I pair my Mindora device?";
"faq.a5" = "Turn on your phone's Bluetooth, launch the Mindora app, tap “Add Device” on the home screen, and follow the on-screen instructions. For detailed step-by-step guidance, see [link to the specific help article].";

"faq.q6" = "Can Mindora sync with Apple Health, Google Fit, or other health apps?";
"faq.a6" = "Yes. In the Mindora app under “Settings” > “Apps & Services,” you can authorize syncing your sleep data to platforms such as Apple Health or Google Fit.";

"faq.q7" = "Do I need a subscription to access all features?";
"faq.a7" = "Mindora's core sleep-aid features (such as basic sounds, light scenes, and aroma diffusion) and AI sleep monitoring are available after you purchase the hardware. A premium membership (where applicable) unlocks a richer sound library, personalized sleep analysis reports, advanced sleep courses, exclusive ASMR content, and more finely personalized AI algorithms, and more.";

"faq.q8" = "How do I manage or cancel my subscription?";
"faq.a8" = "You can manage your subscription at any time under “Account Settings” in the Mindora app. For purchases made through the iOS App Store or Google Play Store, you also need to manage them on the corresponding store's subscription page.";

"faq.q9" = "How does Mindora protect my sleep data and privacy?";
"faq.a9" = "Your data security is paramount. We use industry-standard encryption to protect data in transit and at rest. You can review the full Mindora Privacy Policy to learn how we collect, use, and protect your personal information.";

"faq.q10" = "Can I delete my account and data?";
"faq.a10" = "Yes. You can find the “Delete Account” option under “Account Settings” in the Mindora app, or contact our customer support to request it. After deletion, your personal data will be removed from our active servers.";

"faq.q11" = "Where can I manage or cancel my Mindora membership?";
"faq.a11" = "In-app management: Under “Account Settings” > “My Subscription” in the Mindora app, you can check your next renewal date, change your payment method, or cancel auto-renewal at any time.\n\nApp store management: If you subscribed through the iOS or Android app store, you also need to cancel on the corresponding store's subscription management page. The cancellation takes effect at the end of the current billing cycle.";


