// MARK: - FAQ
"subscription.renewal_management" = "Gestione abbonamento";
"faq.title" = "FAQ Mindora";
"faq.subtitle" = "Mindora è un dispositivo intelligente per il supporto al sonno progettato per migliorare la qualità del sonno attraverso la sinergia multisensoriale e l'IA. Non è un dispositivo medico. Ecco alcune risposte alle domande più comuni.";
"faq.footer.prefix" = "Per altre domande, visita il ";
"faq.footer.link" = "Centro assistenza";
"faq.footer.suffix" = " sul sito web di Mindora.";

"faq.q1" = "Come scelgo un piano di abbonamento?";
"faq.a1" = "Abbonamento mensile: 2,99 $/mese.\n\nAbbonamento annuale: 29,99 $/anno, con un risparmio di circa 2 mesi di costi.\n\nI prezzi effettivi possono variare leggermente in base al tuo Paese o regione e alle tasse applicabili: controlla l'importo finale nella pagina dell'abbonamento.\n\nSe acquisti il dispositivo dallo store online di Mindora, puoi anche aggiungere al tuo ordine un piano di abbonamento annuale prepagato.\n\nI nuovi membri che acquistano un dispositivo prima del 25 dicembre 2026 ricevono il primo anno di abbonamento Mindora in omaggio. Dopo questo periodo gratuito, l'abbonamento deve essere acquistato separatamente.\n\nL'abbonamento Mindora è associato al tuo account Mindora, non al tuo dispositivo Mindora fisico. Se acquisti dispositivi aggiuntivi con un account Mindora esistente, non riceverai un altro mese di abbonamento gratuito.";

"faq.q2" = "Come attivo il mio abbonamento?";
"faq.a2" = "Se hai acquistato un pacchetto hardware che include un periodo di abbonamento, l'abbonamento in omaggio viene attivato automaticamente la prima volta che colleghi con successo il dispositivo e accedi all'app.\n\nSe hai acquistato un abbonamento separatamente, tocca semplicemente “Aggiorna account” o “Abbonati” nell'app Mindora, scegli un piano e completa il pagamento per attivarlo immediatamente.";

"faq.q3" = "Quali sistemi telefonici sono compatibili con l'app Mindora?";
"faq.a3" = "L'app Mindora supporta iPhone con iOS 15 o versioni successive e telefoni Android con Android 11 o versioni successive e supporto Bluetooth 5.0.";

"faq.q4" = "Devo tenere sempre attivo il Bluetooth del telefono?";
"faq.a4" = "Sì. Per mantenere sincronizzati il dispositivo e l'app e per abilitare il controllo remoto, il Bluetooth deve essere attivo. Tuttavia, il dispositivo stesso può eseguire in autonomia i suoi programmi per il sonno preimpostati.";

"faq.q5" = "Come collego/associo un dispositivo?";
"faq.a5" = "Attiva il Bluetooth del telefono, avvia l'app Mindora, tocca “Aggiungi dispositivo” nella schermata principale e segui le istruzioni a schermo. Per una guida dettagliata passo passo, consulta [link all'articolo di aiuto specifico].";

"faq.q6" = "Mindora può sincronizzare i dati con altre app per la salute (come Apple Health o Google Fit)?";
"faq.a6" = "Sì. Nell'app Mindora, in “Impostazioni” > “App e servizi”, puoi autorizzare la sincronizzazione dei tuoi dati del sonno su piattaforme come Apple Health o Google Fit.";

"faq.q7" = "Ho bisogno di un abbonamento a pagamento per usare tutte le funzioni?";
"faq.a7" = "Le funzioni principali di supporto al sonno di Mindora (come suoni di base, scenari luminosi e diffusione di aromi) e il monitoraggio del sonno con IA sono disponibili dopo l'acquisto dell'hardware. Un abbonamento premium (ove applicabile) sblocca una libreria di suoni più ricca, report di analisi del sonno personalizzati, corsi avanzati sul sonno, contenuti ASMR esclusivi, algoritmi di IA personalizzati in modo più preciso e altro ancora.";

"faq.q8" = "Come gestisco o annullo il mio abbonamento?";
"faq.a8" = "Puoi gestire il tuo abbonamento in qualsiasi momento in “Impostazioni account” nell'app Mindora. Per gli acquisti effettuati tramite l'App Store di iOS o il Google Play Store, devi gestirli anche nella pagina degli abbonamenti del rispettivo store.";

"faq.q9" = "I miei dati del sonno sono al sicuro? Come protegge la mia privacy Mindora?";
"faq.a9" = "La sicurezza dei tuoi dati è fondamentale. Utilizziamo una crittografia conforme agli standard del settore per proteggere i dati in transito e a riposo. Puoi consultare l'Informativa sulla privacy completa di Mindora per scoprire come raccogliamo, utilizziamo e proteggiamo le tue informazioni personali.";

"faq.q10" = "Posso eliminare il mio account e i miei dati?";
"faq.a10" = "Sì. Puoi trovare l'opzione “Elimina account” in “Impostazioni account” nell'app Mindora, oppure contattare la nostra assistenza clienti per richiederlo. Dopo l'eliminazione, i tuoi dati personali verranno rimossi dai nostri server attivi.";

"faq.q11" = "Dove posso gestire o annullare il mio abbonamento Mindora?";
"faq.a11" = "Gestione in-app: in “Impostazioni account” > “Il mio abbonamento” nell'app Mindora, puoi controllare la data del prossimo rinnovo, modificare il metodo di pagamento o annullare il rinnovo automatico in qualsiasi momento.\n\nGestione tramite app store: se ti sei abbonato tramite l'app store di iOS o Android, devi annullare anche nella pagina di gestione degli abbonamenti del rispettivo store. L'annullamento ha effetto al termine del ciclo di fatturazione corrente.";


