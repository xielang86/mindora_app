// MARK: - FAQ
"subscription.renewal_management" = "Abonnementverwaltung";
"faq.title" = "Mindora FAQ";
"faq.subtitle" = "Mindora ist ein intelligentes Schlafhilfegerät, das die Schlafqualität durch multisensorische Synergie und KI verbessert. Es ist kein Medizinprodukt. Hier sind einige Antworten auf häufige Fragen.";
"faq.footer.prefix" = "Bei weiteren Fragen besuchen Sie das ";
"faq.footer.link" = "Hilfecenter";
"faq.footer.suffix" = " auf der Mindora-Website.";

"faq.q1" = "Wie wähle ich einen Abonnementplan aus?";
"faq.a1" = "Monatsabonnement: 2,99 $/Monat.\n\nJahresabonnement: 29,99 $/Jahr, womit Sie etwa 2 Monatsgebühren sparen.\n\nDie tatsächlichen Preise können je nach Land oder Region und anfallenden Steuern leicht variieren – bitte überprüfen Sie den endgültigen Betrag auf der Abonnementseite.\n\nWenn Sie Ihr Gerät im Mindora-Onlineshop kaufen, können Sie Ihrer Bestellung auch einen im Voraus bezahlten Jahresmitgliedschaftsplan hinzufügen.\n\nNeue Mitglieder, die vor dem 25. Dezember 2026 ein Gerät kaufen, erhalten ein kostenloses erstes Jahr der Mindora-Mitgliedschaft. Nach diesem kostenlosen Zeitraum muss die Mitgliedschaft separat erworben werden.\n\nDie Mindora-Mitgliedschaft ist an Ihr Mindora-Konto gebunden, nicht an Ihr physisches Mindora-Gerät. Wenn Sie mit einem bestehenden Mindora-Konto zusätzliche Geräte kaufen, erhalten Sie keinen weiteren kostenlosen Mitgliedschaftsmonat.";

"faq.q2" = "Wie aktiviere ich meine Mitgliedschaft?";
"faq.a2" = "Wenn Sie ein Hardware-Paket gekauft haben, das einen Mitgliedschaftszeitraum enthält, wird die kostenlose Mitgliedschaft automatisch aktiviert, sobald Sie Ihr Gerät zum ersten Mal erfolgreich verbinden und sich in der App anmelden.\n\nWenn Sie eine Mitgliedschaft separat erworben haben, tippen Sie einfach in der Mindora App auf „Konto upgraden“ oder „Abonnieren“, wählen Sie einen Plan und schließen Sie die Zahlung ab, um sie sofort zu aktivieren.";

"faq.q3" = "Welche Telefonsysteme sind mit der Mindora App kompatibel?";
"faq.a3" = "Die Mindora App unterstützt iPhones mit iOS 15 oder höher sowie Android-Telefone mit Android 11 oder höher und Bluetooth 5.0-Unterstützung.";

"faq.q4" = "Muss ich das Bluetooth meines Telefons ständig eingeschaltet lassen?";
"faq.a4" = "Ja. Um Ihr Gerät und die App synchron zu halten und die Fernsteuerung zu ermöglichen, muss Bluetooth eingeschaltet sein. Das Gerät selbst kann seine voreingestellten Schlafprogramme jedoch eigenständig ausführen.";

"faq.q5" = "Wie verbinde/koppele ich ein Gerät?";
"faq.a5" = "Schalten Sie das Bluetooth Ihres Telefons ein, starten Sie die Mindora App, tippen Sie auf dem Startbildschirm auf „Gerät hinzufügen“ und folgen Sie den Anweisungen auf dem Bildschirm. Eine ausführliche Schritt-für-Schritt-Anleitung finden Sie unter [Link zum spezifischen Hilfeartikel].";

"faq.q6" = "Kann Mindora Daten mit anderen Gesundheits-Apps (wie Apple Health oder Google Fit) synchronisieren?";
"faq.a6" = "Ja. In der Mindora App unter „Einstellungen“ > „Apps & Dienste“ können Sie die Synchronisierung Ihrer Schlafdaten mit Plattformen wie Apple Health oder Google Fit autorisieren.";

"faq.q7" = "Benötige ich ein kostenpflichtiges Abonnement, um alle Funktionen zu nutzen?";
"faq.a7" = "Die Kern-Schlafhilfe-Funktionen von Mindora (wie Basisklänge, Lichtszenen und Aromazerstäubung) sowie die KI-Schlafüberwachung sind nach dem Kauf der Hardware verfügbar. Eine Premium-Mitgliedschaft (sofern zutreffend) schaltet eine umfangreichere Klangbibliothek, personalisierte Schlafanalyseberichte, fortgeschrittene Schlafkurse, exklusive ASMR-Inhalte, fein personalisierte KI-Algorithmen und mehr frei.";

"faq.q8" = "Wie verwalte oder kündige ich mein Abonnement?";
"faq.a8" = "Sie können Ihr Abonnement jederzeit unter „Kontoeinstellungen“ in der Mindora App verwalten. Bei Käufen über den iOS App Store oder Google Play Store müssen Sie diese auch auf der Abonnementseite des entsprechenden Stores verwalten.";

"faq.q9" = "Sind meine Schlafdaten sicher? Wie schützt Mindora meine Privatsphäre?";
"faq.a9" = "Die Sicherheit Ihrer Daten hat höchste Priorität. Wir verwenden branchenübliche Verschlüsselung, um Daten bei der Übertragung und im Ruhezustand zu schützen. Sie können die vollständige Mindora-Datenschutzrichtlinie einsehen, um zu erfahren, wie wir Ihre personenbezogenen Daten erfassen, verwenden und schützen.";

"faq.q10" = "Kann ich mein Konto und meine Daten löschen?";
"faq.a10" = "Ja. Sie finden die Option „Konto löschen“ unter „Kontoeinstellungen“ in der Mindora App, oder Sie kontaktieren unseren Kundensupport, um dies anzufordern. Nach der Löschung werden Ihre personenbezogenen Daten von unseren aktiven Servern entfernt.";

"faq.q11" = "Wo kann ich meine Mindora-Mitgliedschaft verwalten oder kündigen?";
"faq.a11" = "Verwaltung in der App: Unter „Kontoeinstellungen“ > „Mein Abonnement“ in der Mindora App können Sie jederzeit Ihr nächstes Verlängerungsdatum überprüfen, Ihre Zahlungsmethode ändern oder die automatische Verlängerung kündigen.\n\nVerwaltung im App Store: Wenn Sie über den iOS- oder Android-App-Store abonniert haben, müssen Sie auch auf der Abonnementverwaltungsseite des entsprechenden Stores kündigen. Die Kündigung wird am Ende des aktuellen Abrechnungszeitraums wirksam.";


