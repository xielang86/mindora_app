"explore.empty.message" = "Nach Ihrer ersten Überwachungssitzung\nerhalten Sie hier eine tiefere Analyse Ihrer Schlafqualität.\nBeginnen wir mit Ihrer ersten Schlafüberwachung.";

"explore.empty.intro" = "Beim Einschlafen, beim nächtlichen Aufwachen und beim Zurückgleiten in den Tiefschlaf verfolgt Mindora Ihren Schlafrhythmus und passt seine Unterstützung an Ihren Zustand an.\nDiese Einblicke sind mehr als Veränderungen in Ihren Daten. Sie spiegeln die Szenarien, die Sie nutzen, den Rhythmus der Klänge und die Reaktionen Ihres Körpers wider.";
"explore.empty.intro_detail" = "Scrollen Sie nach unten, um zu sehen, was letzte Nacht passiert ist, was Ihnen am meisten geholfen hat und was Mindora angepasst hat.";
"explore.empty.desc.efficiency" = "Hier sehen Sie, wie Sie einschlafen. Mindora betrachtet, wann Sie einschlafen, wie lange es dauert und wie sich Herzfrequenz und Atmung davor verändern, damit Sie besser verstehen, wie Ihr Schlaf natürlich beginnt.";
"explore.empty.desc.structure" = "Hier sehen Sie, wie sich Ihre Schlafphasen über die Nacht verteilen. Sie erkennen Anteil und Kontinuität von Leicht-, Tief- und REM-Schlaf und verstehen Ihre Schlafstruktur besser – ohne sie als gut oder schlecht zu bewerten.";
"explore.empty.desc.fluctuation" = "Hier sehen Sie, wie sich Ihr Schlaf in der Nacht verändert, wie Ihr Körper reagiert und wann Mindora eingreift. Bei Veränderungen wertet Mindora Ihre physiologischen Signale aus, passt seine Unterstützung an und greift bei Bedarf ein, um Ihren Schlafrhythmus zu schützen.";
"explore.empty.desc.preference" = "Hier werden die Klänge und Szenarien zusammengefasst, die Sie bevorzugen, damit Sie erkennen, was Ihrem Schlaf am besten hilft. Mindora lernt aus Ihren Schlafgewohnheiten und Klangvorlieben und empfiehlt Ihnen persönlichere Wege, Ihren Schlaf zu unterstützen.";
"explore.empty.desc.advice" = "Mindora verfolgt die ganze Nacht über Veränderungen Ihres Schlafs und Ihrer physiologischen Signale. Bei Bedarf greifen KI-gestützte Anpassungen ein, um eine ruhigere, durchgehendere Nacht zu unterstützen.\nSobald Sie Mindora nutzen, zeigt dieser Bereich tiefere Schlafeinblicke – darunter Ihr Einschlafen, Ihre Schlafstruktur, nächtliche Veränderungen und empfohlene Klangwelten.";
