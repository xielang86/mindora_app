// MARK: - FAQ
"subscription.renewal_management" = "Gestión de suscripción";
"faq.title" = "Preguntas frecuentes de Mindora";
"faq.subtitle" = "Mindora es un dispositivo inteligente de ayuda al sueño diseñado para mejorar la calidad del sueño mediante la sinergia multisensorial y la IA. No es un dispositivo médico. Aquí tienes algunas respuestas a preguntas frecuentes.";
"faq.footer.prefix" = "Para otras preguntas, visita el ";
"faq.footer.link" = "Centro de ayuda";
"faq.footer.suffix" = " en el sitio web de Mindora.";

"faq.q1" = "¿Cómo elijo un plan de suscripción?";
"faq.a1" = "Suscripción mensual: 2,99 $/mes.\n\nSuscripción anual: 29,99 $/año, lo que te ahorra aproximadamente 2 meses de cuota.\n\nLos precios reales pueden variar ligeramente según tu país o región y los impuestos aplicables; consulta el importe final en la página de suscripción.\n\nSi compras tu dispositivo en la tienda en línea de Mindora, también puedes añadir un plan de membresía anual prepagado a tu pedido.\n\nLos nuevos miembros que compren un dispositivo antes del 25 de diciembre de 2026 reciben un primer año de membresía de Mindora de regalo. Tras este periodo gratuito, la membresía debe adquirirse por separado.\n\nLa membresía de Mindora está vinculada a tu cuenta de Mindora, no a tu dispositivo Mindora físico. Si compras dispositivos adicionales con una cuenta de Mindora existente, no recibirás otro mes de membresía gratis.";

"faq.q2" = "¿Cómo activo mi membresía?";
"faq.a2" = "Si compraste un paquete de hardware que incluye un periodo de membresía, la membresía de regalo se activa automáticamente la primera vez que conectas tu dispositivo correctamente e inicias sesión en la app.\n\nSi compraste una membresía por separado, solo tienes que tocar “Mejorar cuenta” o “Suscribirse” en la app de Mindora, elegir un plan y completar el pago para activarla de inmediato.";

"faq.q3" = "¿Qué sistemas de teléfono son compatibles con la app de Mindora?";
"faq.a3" = "La app de Mindora es compatible con iPhones con iOS 15 o posterior y con teléfonos Android con Android 11 o posterior que admitan Bluetooth 5.0.";

"faq.q4" = "¿Necesito mantener el Bluetooth del teléfono encendido en todo momento?";
"faq.a4" = "Sí. Para mantener sincronizados tu dispositivo y la app y habilitar el control remoto, el Bluetooth debe estar encendido. No obstante, el dispositivo puede ejecutar de forma independiente sus programas de sueño preestablecidos.";

"faq.q5" = "¿Cómo conecto o empareja un dispositivo?";
"faq.a5" = "Enciende el Bluetooth de tu teléfono, abre la app de Mindora, toca “Añadir dispositivo” en la pantalla de inicio y sigue las instrucciones en pantalla. Para obtener una guía detallada paso a paso, consulta [enlace al artículo de ayuda específico].";

"faq.q6" = "¿Mindora puede sincronizar datos con otras apps de salud (como Apple Salud o Google Fit)?";
"faq.a6" = "Sí. En la app de Mindora, en “Ajustes” > “Apps y servicios”, puedes autorizar la sincronización de tus datos de sueño con plataformas como Apple Salud o Google Fit.";

"faq.q7" = "¿Necesito una suscripción de pago para usar todas las funciones?";
"faq.a7" = "Las funciones principales de ayuda al sueño de Mindora (como sonidos básicos, escenas de luz y difusión de aromas) y la monitorización del sueño con IA están disponibles tras comprar el hardware. Una membresía premium (cuando corresponda) desbloquea una biblioteca de sonidos más amplia, informes personalizados de análisis del sueño, cursos avanzados de sueño, contenido ASMR exclusivo, algoritmos de IA más personalizados y mucho más.";

"faq.q8" = "¿Cómo gestiono o cancelo mi suscripción?";
"faq.a8" = "Puedes gestionar tu suscripción en cualquier momento en “Ajustes de la cuenta” de la app de Mindora. En el caso de las compras realizadas a través de la App Store de iOS o Google Play Store, también debes gestionarlas en la página de suscripciones de la tienda correspondiente.";

"faq.q9" = "¿Mis datos de sueño están seguros? ¿Cómo protege Mindora mi privacidad?";
"faq.a9" = "La seguridad de tus datos es primordial. Usamos cifrado estándar del sector para proteger los datos en tránsito y en reposo. Puedes consultar la Política de privacidad completa de Mindora para saber cómo recopilamos, usamos y protegemos tu información personal.";

"faq.q10" = "¿Puedo eliminar mi cuenta y mis datos?";
"faq.a10" = "Sí. Puedes encontrar la opción “Eliminar cuenta” en “Ajustes de la cuenta” de la app de Mindora, o contactar con nuestro servicio de atención al cliente para solicitarlo. Tras la eliminación, tus datos personales se eliminarán de nuestros servidores activos.";

"faq.q11" = "¿Dónde puedo gestionar o cancelar mi membresía de Mindora?";
"faq.a11" = "Gestión en la app: en “Ajustes de la cuenta” > “Mi suscripción” de la app de Mindora, puedes consultar tu próxima fecha de renovación, cambiar tu método de pago o cancelar la renovación automática en cualquier momento.\n\nGestión en la tienda de apps: si te suscribiste a través de la tienda de apps de iOS o Android, también debes cancelar en la página de gestión de suscripciones de la tienda correspondiente. La cancelación surte efecto al final del ciclo de facturación actual.";


